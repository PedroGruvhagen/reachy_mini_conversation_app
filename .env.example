OPENAI_API_KEY=
MODEL_NAME="gpt-realtime"

# Local vision model (only used with --local-vision CLI flag)
# By default, vision is handled by gpt-realtime when the camera tool is used
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# To select a specific profile with custom instructions and tools, to be placed in profiles/<myprofile>/__init__.py
REACHY_MINI_CUSTOM_PROFILE="example"

# =============================================================================
# Headless Mode Configuration (for Ubuntu deployment without UI)
# =============================================================================

# Wake Word Detection
# Available models: hey_jarvis (default), alexa, hey_mycroft, hey_rhasspy, ok_nabu
WAKE_WORD_MODEL=hey_jarvis
# Path to custom wake word model (overrides WAKE_WORD_MODEL if set)
# WAKE_WORD_MODEL_PATH=/path/to/custom/model.onnx
# Confidence threshold for wake word detection (0.0-1.0)
WAKE_WORD_CONFIDENCE_THRESHOLD=0.5
# Cooldown between wake word detections in seconds
WAKE_WORD_COOLDOWN_SECONDS=10.0

# State Machine
# Seconds of silence before returning to SLEEPING state
SILENCE_TIMEOUT_SECONDS=120
# Maximum time in AWAKE state before forcing SLEEPING (30 minutes default)
MAX_AWAKE_SECONDS=1800
# Minimum time in SLEEPING state to prevent thrashing (seconds)
MIN_SLEEP_SECONDS=5
# State persistence file path (for surviving restarts)
# STATE_FILE_PATH=~/.reachy_mini/state.json

# Voice Activity Detection (VAD)
# RMS energy threshold for speech detection (int16 audio)
# Lower = more sensitive, typical range: 500-2000
SPEECH_ENERGY_THRESHOLD=1000

# Pre-roll Buffer
# Seconds of audio to buffer before wake word (avoids clipping)
PREROLL_SECONDS=2.0

# Audio Device Configuration
# Input device: "default" or device index (run: python -c "import sounddevice; print(sounddevice.query_devices())")
# AUDIO_INPUT_DEVICE=default
# Sample rate for audio capture (48000 is typical for most devices)
AUDIO_SAMPLE_RATE=48000

# Logging
LOG_LEVEL=INFO
# LOG_FILE=/var/log/reachy-mini/conversation.log

# =============================================================================
# Transcription & Recording Configuration
# =============================================================================

# Recording directory for conversation audio files
RECORDINGS_PATH=~/.reachy_mini/recordings

# Privacy control: Enable/disable audio recording (true/false)
ENABLE_RECORDING=true

# Retention policy: Days to keep audio recordings (0 = keep forever)
AUDIO_RETENTION_DAYS=30

# Retention policy: Days to keep transcripts in database (0 = keep forever)
TRANSCRIPT_RETENTION_DAYS=90